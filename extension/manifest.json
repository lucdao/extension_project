{
  "manifest_version": 3,
  "name": "Cảnh báo Phishing AI",
  "version": "1.0",
  "description": "Phát hiện và cảnh báo link lừa đảo sử dụng AI ResNet18",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}