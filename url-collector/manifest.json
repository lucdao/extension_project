{
  "manifest_version": 3,
  "name": "Auto Link Collector (Continuous)",
  "description": "Tự động thu thập link visible, lưu trữ và lọc trùng lặp liên tục.",
  "version": "2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Collector Control"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}